#include <stdio.h>
#include <string.h>

struct Student {
    int roll_no;
    char name[50];
    float marks[3];
    float total;
    float percentage;
    char result[10];
};

int main() {
    int n;

    printf("Enter number of students: ");
    scanf("%d", &n);

    struct Student s[n];

    for (int i = 0; i < n; i++) {
        printf("\nEnter details for Student %d:\n", i + 1);
        printf("Roll Number: ");
        scanf("%d", &s[i].roll_no);
        getchar();

        printf("Name: ");
        fgets(s[i].name, sizeof(s[i].name), stdin);
        s[i].name[strcspn(s[i].name, "\n")] = '\0';

        s[i].total = 0;
        for (int j = 0; j < 3; j++) {
            printf("Marks in Subject %d (out of 100): ", j + 1);
            scanf("%f", &s[i].marks[j]);
            s[i].total += s[i].marks[j];
        }

        s[i].percentage = (s[i].total / 300.0) * 100.0;

        if (s[i].marks[0] >= 35 && s[i].marks[1] >= 35 && s[i].marks[2] >= 35) {
            strcpy(s[i].result, "PASS");
        } else {
            strcpy(s[i].result, "FAIL");
        }
    }

    printf("\n-----------------------------------------------------------------\n");
    printf("Roll No\tName\t\tTotal\tPercentage\tResult\n");
    printf("-----------------------------------------------------------------\n");

    for (int i = 0; i < n; i++) {
        printf("%d\t%-15s\t%.2f\t%.2f%%\t\t%s\n",
               s[i].roll_no,
               s[i].name,
               s[i].total,
               s[i].percentage,
               s[i].result);
    }

    return 0;
}
